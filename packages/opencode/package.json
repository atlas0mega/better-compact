{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "better-compact",
    "version": "0.3.0",
    "type": "module",
    "description": "OpenCode plugin that improves long-session context with boundary-time pruning",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./tui": {
            "types": "./dist/tui.d.ts",
            "import": "./dist/tui.js"
        },
        "./rpc": {
            "types": "./dist/rpc.d.ts",
            "import": "./dist/rpc.js"
        }
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "pnpm run clean && tsup",
        "verify:package": "node scripts/verify-package.mjs",
        "verify:release": "node scripts/verify-release.mjs",
        "smoke:install": "node scripts/smoke-opencode-install.mjs",
        "smoke:host": "node scripts/smoke-v2-host.mjs",
        "smoke:native-fallback": "node scripts/smoke-v2-native-fallback.mjs",
        "smoke:tui": "node scripts/smoke-v2-tui.mjs",
        "check:package": "pnpm run build && pnpm run verify:package",
        "prepublishOnly": "pnpm run check:package",
        "dev": "opencode plugin dev",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test tests/v2-*.test.ts"
    },
    "keywords": [
        "opencode",
        "opencode-plugin",
        "plugin",
        "context",
        "pruning",
        "optimization",
        "tokens"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AshishKumar4/better-compact.git",
        "directory": "packages/opencode"
    },
    "bugs": {
        "url": "https://github.com/AshishKumar4/better-compact/issues"
    },
    "homepage": "https://github.com/AshishKumar4/better-compact#readme",
    "author": "AshishKumar4",
    "license": "AGPL-3.0-or-later",
    "engines": {
        "opencode": ">=2.0.18 <3"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@opencode/ai": "2.0.18",
        "@opencode/plugin": "2.0.18"
    },
    "devDependencies": {
        "@better-compact/core": "workspace:*",
        "@opencode/ai": "2.0.18",
        "@opencode/plugin": "2.0.18",
        "@types/node": "^25.5.0",
        "jsonc-parser": "^3.3.1",
        "tsup": "^8.5.1",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2"
    },
    "files": [
        "index.js",
        "dist/index.js",
        "dist/index.d.ts",
        "dist/tui.js",
        "dist/tui.d.ts",
        "dist/rpc.js",
        "dist/rpc.d.ts",
        "better-compact.schema.json",
        "README.md",
        "LICENSE"
    ]
}
